# Cấu hình backend; copy sang .env nếu chưa có, không ghi đè file đã chỉnh.
# FE dùng frontend/.env.local với NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000.
# CORS phải khớp origin trang FE; đổi cổng FE thì cập nhật RESIM_CORS_ORIGINS.

RESIM_STORAGE_DIR=.storage
RESIM_MAX_UPLOAD_BYTES=10485760
RESIM_MAX_IMAGE_PIXELS=20000000
RESIM_MAX_RESULT_PIXELS=32000000
RESIM_COLORIZATION_MODEL_DIR=models/colorization
RESIM_IMAGE_TTL_HOURS=24
RESIM_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# AI: openai | gemini | openai_compatible; dùng một provider tại một thời điểm.
# Chọn model có hỗ trợ ảnh và JSON. Key chỉ lưu ở backend.
RESIM_AI_PROVIDER=openai
RESIM_AI_API_KEY=
RESIM_AI_MODEL=
# Để trống cho OpenAI/Gemini chính thức; compatible bắt buộc base URL (gồm /v1 nếu cần).
RESIM_AI_BASE_URL=
RESIM_AI_TIMEOUT_SECONDS=60
RESIM_AI_PREVIEW_MAX_EDGE=1024
# In toàn bộ payload (cả ảnh base64) và output AI ở terminal; tắt khi không debug.
RESIM_AI_DEBUG_LOG=true
